# Normalizar line endings automáticamente
* text=auto

# Java y archivos de texto → LF
*.java   text eol=lf
*.xml    text eol=lf
*.json   text eol=lf
*.ts     text eol=lf
*.html   text eol=lf
*.scss   text eol=lf
*.css    text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.properties text eol=lf

# Scripts Windows → CRLF
*.cmd    text eol=crlf
*.bat    text eol=crlf

# Maven wrapper → LF
mvnw     text eol=lf

# Binarios — sin conversión
*.png    binary
*.jpg    binary
*.ico    binary
*.jar    binary
*.war    binary
